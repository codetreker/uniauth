{
  "name": "@uniauth/console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "mockup": "vite --host 127.0.0.1 --open /console/mockup.html",
    "check": "tsc --noEmit",
    "build": "pnpm check && vite build",
    "test": "vitest run",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.json\" \"*.html\" vite.config.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
